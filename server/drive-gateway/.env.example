PORT=8080
# Dedicated database login granted firecheck_gateway_server, with TLS enabled.
DATABASE_URL=postgresql://gateway_login:PASSWORD@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
DRIVE_INPUT_ROOT=1PG7WAgzaViIosQdKrH9KWxTJApYfq-0q
DRIVE_OUTPUT_ROOT=1wsT0jAPQDQOlO08GtNSIf2XAXTDXFjIY
DRIVE_PUBLISHED_ROOT=
# Selected configuration: a shared folder in My Drive; no organization needed.
DRIVE_AUTH_MODE=oauth
# Mount the Secret Manager bundle here in Cloud Run.
GOOGLE_OAUTH_BUNDLE_FILE=/secrets/drive/oauth.json
# Local owner setup only (do not add the client JSON to the repository):
# GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/client_secret_download.json
# DRIVE_OWNER_EMAIL=jnescarlan@up.edu.ph
# Individual injected variables are also supported instead of the bundle file:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Optional future Workspace deployment only:
# DRIVE_AUTH_MODE=service_account
# SHARED_DRIVE_ID=
# DRIVE_SERVICE_ACCOUNT=firecheck-drive@PROJECT.iam.gserviceaccount.com
